<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgendaDrive</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgendaDrive.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    @{
        // Marca no menu a página atual.
        var nome = User.Identity?.Name ?? "";
        var iniciais = string.Concat(nome.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
        var controladorAtual = ViewContext.RouteData.Values["controller"]?.ToString();
        var acaoAtual = ViewContext.RouteData.Values["action"]?.ToString();
        bool Atual(string controlador, string? acao = null) =>
            controladorAtual == controlador && (acao == null || acaoAtual == acao);
        string Link(string controlador, string? acao = null) => Atual(controlador, acao) ? "nav-link ativo" : "nav-link";
        string? Corrente(string controlador, string? acao = null) => Atual(controlador, acao) ? "page" : null;
    }
    <header class="topo">
        <nav class="navbar navbar-expand-md py-2">
            <div class="container">
                <a class="marca me-4" asp-controller="Home" asp-action="Index">
                    @* Símbolo: dois pontos ligados por uma rota (origem e destino). *@
                    <span class="marca-simbolo" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                            <circle cx="4" cy="4" r="2.2" stroke="#fff" stroke-width="1.6" />
                            <circle cx="14" cy="14" r="2.2" fill="#F5A524" />
                            <path d="M6 4h5a3 3 0 0 1 0 6H7a3 3 0 0 0 0 6h4.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </span>
                    AgendaDrive
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="@Link("Corridas", "Solicitacoes")" aria-current="@Corrente("Corridas", "Solicitacoes")" asp-controller="Corridas" asp-action="Solicitacoes">Solicitações</a></li>
                            <li class="nav-item"><a class="@Link("Bloqueios")" aria-current="@Corrente("Bloqueios")" asp-controller="Bloqueios" asp-action="Index">Agenda</a></li>
                            <li class="nav-item"><a class="@Link("Tarifas")" aria-current="@Corrente("Tarifas")" asp-controller="Tarifas" asp-action="Index">Tarifas</a></li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><a class="@Link("Corridas", "Nova")" aria-current="@Corrente("Corridas", "Nova")" asp-controller="Corridas" asp-action="Nova">Pedir corrida</a></li>
                            <li class="nav-item"><a class="@Link("Corridas", "Minhas")" aria-current="@Corrente("Corridas", "Minhas")" asp-controller="Corridas" asp-action="Minhas">Minhas corridas</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center gap-2 mt-2 mt-md-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item usuario">
                                <span class="avatar" aria-hidden="true">@iniciais</span>
                                <span>@nome</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Conta" asp-action="Sair" method="post">
                                    <button type="submit" class="btn btn-sair">Sair</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="@Link("Conta", "Entrar")" asp-controller="Conta" asp-action="Entrar">Entrar</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Conta" asp-action="Cadastrar">Criar conta</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Mensagens" />
            @RenderBody()
        </main>
    </div>

    <footer class="rodape">
        <div class="container">
            &copy; 2026 AgendaDrive. Mapas &copy; OpenStreetMap contributors.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
