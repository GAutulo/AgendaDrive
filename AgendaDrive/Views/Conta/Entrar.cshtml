@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}

<div class="acesso">
    <div class="painel">
        <h1>Entrar</h1>
        <p class="subtitulo">Acesse sua conta para pedir e acompanhar corridas.</p>

        <form asp-action="Entrar" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Senha" class="form-label"></label>
                <input asp-for="Senha" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Senha" class="text-danger small"></span>
            </div>
            <div class="text-end mb-2"><a asp-action="EsqueciSenha" class="small fw-semibold">Esqueci minha senha</a></div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>
    </div>
    <p class="mt-3 text-center text-muted">
        Ainda não tem conta? <a asp-action="Cadastrar" class="fw-semibold">Criar conta</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
