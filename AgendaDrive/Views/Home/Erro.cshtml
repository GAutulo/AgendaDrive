@model ErroViewModel
@{
    var naoEncontrado = Model.StatusCode == 404;
    ViewData["Title"] = naoEncontrado ? "Página não encontrada" : "Erro";
}

@* Página de erro amigável: nunca mostra mensagem técnica. O detalhe fica só em App_Data/logs. *@
<div class="py-5 text-center">
    @if (naoEncontrado)
    {
        <h1 class="h3">Página não encontrada</h1>
        <p class="text-muted">O endereço que você tentou abrir não existe ou foi removido.</p>
    }
    else if (Model.StatusCode == 429)
    {
        <h1 class="h3">Muitas tentativas</h1>
        <p class="text-muted">Aguarde um minuto e tente novamente.</p>
    }
    else
    {
        <h1 class="h3">Ops, algo deu errado</h1>
        <p class="text-muted">Não foi possível concluir a operação. Tente novamente em alguns instantes.</p>
        <p class="small text-muted">Se o problema continuar, informe este código: <code>@Model.Codigo</code></p>
    }
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Voltar ao início</a>
</div>
