@{
    ViewData["Title"] = "Início";
}

<div class="py-4">
    <h1 class="display-6 fw-semibold">AgendaDrive</h1>
    <p class="lead">Agendamento e precificação de corridas particulares.</p>
    <p class="text-muted">
        O cliente informa origem e destino, vê a rota no mapa e recebe uma estimativa de preço.
        O motorista aprova as solicitações, organiza a agenda e configura as tarifas.
    </p>
    <a class="btn btn-primary" asp-controller="Tarifas" asp-action="Index">Gerenciar tarifas</a>
</div>
