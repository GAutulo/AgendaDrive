@model List<Bloqueio>
@{
    ViewData["Title"] = "Bloqueios";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Agenda</h1>
        <p>Períodos bloqueados: neles o cliente não consegue pedir corridas. O motivo só você vê.</p>
    </div>
    <a asp-action="Criar" class="btn btn-primary">Bloquear período</a>
</div>

@if (Model.Count == 0)
{
    <div class="painel vazio">
        <strong>Nenhum período bloqueado</strong>
        Bloqueie horários em que você não pode atender.
    </div>
}
else
{
    <div class="painel painel-tabela table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Início</th>
                    <th>Fim</th>
                    <th class="d-none d-md-table-cell">Motivo</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bloqueio in Model)
                {
                    <tr>
                        <td>@bloqueio.Inicio.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@bloqueio.Fim.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="d-none d-md-table-cell">@bloqueio.MotivoPrivado</td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                <a asp-action="Editar" asp-route-id="@bloqueio.ID" class="btn btn-sm btn-outline-secondary">Editar</a>
                                <form asp-action="Cancelar" asp-route-id="@bloqueio.ID" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
