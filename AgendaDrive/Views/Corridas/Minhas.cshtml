@model List<Corrida>
@{
    ViewData["Title"] = "Minhas corridas";
}

<div class="cabecalho-pagina">
    <div>
        <h1>Minhas corridas</h1>
        <p>Acompanhe a situação dos seus pedidos.</p>
    </div>
    <a asp-action="Nova" class="btn btn-primary">Pedir corrida</a>
</div>

@if (Model.Count == 0)
{
    <div class="painel vazio">
        <strong>Nenhuma corrida ainda</strong>
        Peça a primeira e acompanhe aqui a confirmação do motorista.
        <div class="mt-3"><a asp-action="Nova" class="btn btn-primary">Pedir corrida</a></div>
    </div>
}
else
{
    <div class="painel painel-tabela">
        <div class="list-group list-group-flush">
            @foreach (var corrida in Model)
            {
                <a asp-action="Detalhes" asp-route-id="@corrida.ID" class="list-group-item list-group-item-action item-corrida">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                        <span class="fw-semibold">@corrida.DataHora.ToString("dd/MM/yyyy 'às' HH:mm")</span>
                        <partial name="_Status" model="corrida.Status" />
                    </div>
                    <div class="d-flex justify-content-between align-items-end gap-3">
                        <span class="small text-muted">@corrida.Origem → @corrida.Destino</span>
                        <span class="fw-bold text-nowrap">@corrida.PrecoEstimado.ToString("C")</span>
                    </div>
                </a>
            }
        </div>
    </div>
}
