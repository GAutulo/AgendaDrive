@using AgendaDrive.Models.Negocio
@model List<Corrida>
@{
    ViewData["Title"] = "Corridas";
    var statusFiltro = (string?)ViewBag.Status;
    var inicio = (DateTime?)ViewBag.Inicio;
    var fim = (DateTime?)ViewBag.Fim;
    var total = Model.Where(c => c.Status is "Confirmada" or "Concluida").Sum(c => c.PrecoEstimado);
}

<h1 class="h3 mb-3">Corridas</h1>

@* Formulário GET: o filtro só lê dados, então fica na URL e não precisa de token. *@
<form asp-action="Solicitacoes" method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-3">
        <label for="status" class="form-label">Situação</label>
        <select id="status" name="status" class="form-select">
            <option value="">Todas</option>
            @foreach (var status in CorridaNegocio.Status)
            {
                <option value="@status" selected="@(status == statusFiltro)">@status</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label for="inicio" class="form-label">De</label>
        <input id="inicio" name="inicio" type="date" class="form-control" value="@inicio?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-md-3">
        <label for="fim" class="form-label">Até</label>
        <input id="fim" name="fim" type="date" class="form-control" value="@fim?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Nenhuma corrida encontrada.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Situação</th>
                    <th class="d-none d-md-table-cell">Cliente</th>
                    <th class="d-none d-lg-table-cell">Trajeto</th>
                    <th class="text-end">Valor</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var corrida in Model)
                {
                    <tr>
                        <td>@corrida.DataHora.ToString("dd/MM HH:mm")</td>
                        <td><partial name="_Status" model="corrida.Status" /></td>
                        <td class="d-none d-md-table-cell">@corrida.Usuario.Nome</td>
                        <td class="d-none d-lg-table-cell">@corrida.Origem → @corrida.Destino</td>
                        <td class="text-end">@corrida.PrecoEstimado.ToString("C")</td>
                        <td class="text-end"><a asp-action="Detalhes" asp-route-id="@corrida.ID" class="btn btn-sm btn-outline-secondary">Abrir</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-end"><strong>@Model.Count corrida(s).</strong> Confirmadas e concluídas somam @total.ToString("C").</p>
}
