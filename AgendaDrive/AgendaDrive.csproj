<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Versão corrigida de uma dependência do SqlClient (a 9.0.11 tem vulnerabilidade conhecida). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nunca publicar credenciais nem dados: o secrets.json de produção é enviado à mão para a hospedagem,
         e a publicação não pode sobrescrevê-lo com o de desenvolvimento. -->
    <Content Update="App_Secrets\**" CopyToPublishDirectory="Never" />
    <Content Update="App_Data\**" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
